{
	"name": "mradib-com",
	"version": "3.1.0",
	"private": false,
	"scripts": {
		"build": "next build",
		"check-types": "tsc --noEmit --pretty",
		"dev": "next dev",
		"check": "biome check",
		"check:fix": "biome check --write",
		"format": "biome format .",
		"img:build": "node scripts/optimize-images.mjs",
		"og:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs scripts/og/generate-og-images.mjs",
		"format:fix": "biome format . --write",
		"lint": "biome lint",
		"lint:fix": "biome lint --fix",
		"lint:fix:unsafe": "biome lint --fix --unsafe",
		"start": "next start",
		"start:local": "npx serve@latest out",
		"test:about-videos": "node --test tests/about-story-videos.test.mjs",
		"test:guides": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs --test tests/guides.test.mjs",
		"test:guides-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs --test tests/guides-data.test.mjs",
		"verify:photos": "node scripts/verify-profile-images.mjs",
		"verify:seo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs scripts/verify-sitemap.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs scripts/verify-metadata.mjs && node scripts/verify-constraints.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs scripts/verify-article-privacy.mjs",
		"verify:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs scripts/verify-links.mjs",
		"qr:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs scripts/generate-share-qr.mjs",
		"test:share": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-alias.mjs --test tests/share-qr.test.mjs",
		"test:share-browser": "node tests/share-page.browser.mjs"
	},
	"browserslist": "defaults, not ie <= 11",
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@next/third-parties": "^16.2.10",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"clsx": "^2.1.1",
		"next": "^16.2.10",
		"next-themes": "^0.4.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-syntax-highlighter": "^16.1.1",
		"schema-dts": "^2.0.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/newsreader": "^5.3.0",
		"@fontsource/vazirmatn": "^5.3.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"globals": "17.7.0",
		"jsqr": "^1.4.0",
		"playwright-core": "^1.56.1",
		"qrcode": "^1.5.4",
		"sharp": "0.35.3",
		"typescript": "^6.0.3"
	}
}
